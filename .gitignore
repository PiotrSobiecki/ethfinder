.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# private.ts i index.html to oryginalne pliki referencyjne (konsolowy prototyp
# i jednoplikowa wersja UI). Sa wersjonowane celowo. Z buildu wyklucza je
# tsconfig.json, z obrazu Dockera .dockerignore. Wczesniej staly tutaj jako
# wpisy ignore, co nic nie dawalo - oba pliki sa sledzone przez gita - a
# sugerowalo, ze nie powinny byc publiczne.
